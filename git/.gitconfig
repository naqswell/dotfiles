[user]
	name = naqswell
	email = naqswell@gmail.com

[core]
	autocrlf = input
	excludesFile = ~/.config/git/ignore

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[diff]
	colorMoved = default

[rerere]
	enabled = true

# === MTS workspace: override identity by remote URL (path-independent) ===
# Срабатывает для любого репо с remote на gitlab.services.mts.ru,
# независимо от того, где он лежит на диске. Не зависит от имени папки.
[includeIf "hasconfig:remote.*.url:https://gitlab.services.mts.ru/**"]
	path = ~/.config/git/config.mts
[includeIf "hasconfig:remote.*.url:git@gitlab.services.mts.ru:**"]
	path = ~/.config/git/config.mts
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
