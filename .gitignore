# Local secrets / per-machine overrides — sourced from .zshrc but never committed.
*.local
*.secret
.env
.envrc

# macOS
.DS_Store
._*

# Editor / scratch backups
*.bak
*.bak.*
*.orig
*.swp

# Codex CLI: ~/.codex — симлинк внутрь этого репозитория, поэтому весь рантайм
# оседает здесь. Версионируем только AGENTS.md и rules/, остальное машинное.
codex/.codex/*.sqlite*
codex/.codex/cache/
codex/.codex/.tmp/
codex/.codex/sessions/
codex/.codex/plugins/
codex/.codex/shell_snapshots/
codex/.codex/tmp/
# Скиллы, которые Codex приносит с собой; свои скиллы (вне .system) версионируем.
codex/.codex/skills/.system/
codex/.codex/history.jsonl
codex/.codex/installation_id
codex/.codex/models_cache.json
codex/.codex/version.json
codex/.codex/.personality_migration
codex/.codex/.sandbox_migration
# Абсолютные пути, trusted_hash хуков и trust-level проектов — на каждой машине свои.
codex/.codex/config.toml
codex/.codex/hooks.json
